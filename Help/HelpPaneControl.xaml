<Page x:Class="TNovCommon.Help.HelpPaneControl"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      MinWidth="240"
      Background="{DynamicResource BgBrush}"
      TextOptions.TextFormattingMode="Display"
      RenderOptions.BitmapScalingMode="HighQuality">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок текущего раздела -->
        <TextBlock x:Name="SectionTitle"
                   Text="Справка TNov"
                   Style="{StaticResource PanelHeaderStyle}"
                   FontSize="14"
                   TextWrapping="Wrap"/>

        <!-- Поиск по разделам -->
        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Поиск"
                       Style="{StaticResource DialogHintStyle}"
                       VerticalAlignment="Center"
                       Margin="0,0,6,0"/>
            <TextBox x:Name="SearchBox"
                     Grid.Column="1"
                     Style="{StaticResource DarkCompactTextBoxStyle}"
                     TextChanged="SearchBox_TextChanged"/>
        </Grid>

        <!-- Оглавление -->
        <TreeView x:Name="TopicsTree"
                  Grid.Row="2"
                  Style="{StaticResource DarkTreeViewStyle}"
                  ItemContainerStyle="{StaticResource DarkTreeViewItemStyle}"
                  MaxHeight="220"
                  Margin="0,8,0,0"
                  BorderThickness="0"
                  SelectedItemChanged="TopicsTree_SelectedItemChanged"/>

        <!-- Содержимое раздела -->
        <Border Grid.Row="3"
                Style="{StaticResource PanelFrameStyle}"
                Margin="0,8,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <FlowDocumentScrollViewer x:Name="ArticleViewer"
                                          IsSelectionEnabled="True"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Padding="0"
                                          Margin="10,8,4,8"/>

                <Button x:Name="OpenInWikiButton"
                        Grid.Row="1"
                        Content="Открыть в вики"
                        Style="{StaticResource SecondaryButtonStyle}"
                        MinHeight="28"
                        Padding="10,5"
                        FontSize="12"
                        HorizontalAlignment="Stretch"
                        Margin="10,0,10,10"
                        Click="OpenInWikiButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</Page>
